# ==========================================================
# Modèle de configuration : copier ce fichier en .env
#   cp .env.example .env
# puis remplacer chaque valeur "change_me_..." par un secret fort.
# Le fichier .env est ignoré par Git et par Docker : ne jamais le commiter.
# ==========================================================

# --- Compte administrateur MongoDB (root, créé au premier démarrage) ---
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change_me_root_password

# --- Compte applicatif (readWrite sur APP_DB_NAME, créé par init-mongo.js) ---
APP_DB_USER=healthcare_user
APP_DB_PASSWORD=change_me_app_password
APP_DB_NAME=healthcare_db

# --- Compte analyste (read seul sur APP_DB_NAME, créé par init-mongo.js) ---
READ_DB_USER=healthcare_reader
READ_DB_PASSWORD=change_me_reader_password

# --- URI utilisée par les scripts dans le conteneur (hôte "mongodb", port interne 27017) ---
# Utilisateur, mot de passe et base doivent correspondre à APP_DB_USER / APP_DB_PASSWORD / APP_DB_NAME.
MONGO_APP_URI=mongodb://healthcare_user:change_me_app_password@mongodb:27017/healthcare_db

# --- URI pour un lancement manuel depuis la machine hôte (port exposé 27018) ---
MONGO_LOCAL_URI=mongodb://healthcare_user:change_me_app_password@localhost:27018/healthcare_db
